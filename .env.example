# Database
DB_TYPE=sqlite           # sqlite or mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=reporting_agent
SQLITE_PATH=data/reporting_agent.db

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# Report
MAX_EVALUATOR_ITERATIONS=3

# Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
REPORT_RECIPIENTS=manager@company.com,analyst@company.com

# LangSmith (optional observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=proactive-reporting-agent
